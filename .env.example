# CareerPilot AI Configuration
# Database
DATABASE_URL=sqlite:///./storage/careerpilot.db

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Embeddings & Search
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DB_DIR=./storage/chromadb
ENABLE_SEMANTIC_SEARCH=true

# Storage
RESUME_STORAGE_DIR=./storage/resumes

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8005
FRONTEND_PORT=8501
LOG_LEVEL=INFO

# Agent Execution Limits
MAX_AGENT_TOOL_STEPS=6
